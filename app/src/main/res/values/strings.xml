    <string name="accessibility_service_label">WakeUp app blocking</string>
    <string name="accessibility_service_description">Lets WakeUp block other apps while an alarm is ringing, so you have to scan your tag to get out of bed. WakeUp only checks which app is in the foreground; it never reads screen content.</string>
