    <!-- Power-menu guard (accessibility, best-effort) -->
    <string name="power_menu_title">POWER MENU</string>
    <string name="power_menu_summary">While an alarm rings, close the power menu if it\'s opened, so it can\'t be tapped to power off and skip the alarm. Best-effort — a hardware power-off still works.</string>
    <string name="power_menu_enable">Guard power menu during alarms</string>
    <string name="power_menu_service_needed">Needs the WakeUp accessibility service. Turn it on in Android settings.</string>
    <!-- Location failsafe (per NFC tag) -->
    <string name="failsafe">Failsafe</string>
    <string name="failsafe_title">FAILSAFE</string>
    <string name="failsafe_summary">If you\'re away from an NFC tag, its alarms can\'t be dismissed. For each tag, pick where it lives and a daily check time: if you\'re more than 100 m from that spot then, the tag\'s alarms that would ring before the next check are deactivated.</string>
    <string name="failsafe_how_it_works">Recurring alarms skip one ring and come back on their own; one-time alarms are turned off. If your location can\'t be found, alarms stay on.</string>
    <string name="failsafe_access_title">LOCATION ACCESS</string>
    <string name="failsafe_access_precise_needed">Needs precise location access.</string>
    <string name="failsafe_access_background_needed">Checks run in the background, so location must be set to \"Allow all the time\".</string>
